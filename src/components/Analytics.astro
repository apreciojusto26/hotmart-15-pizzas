---
// Google Analytics 4. Solo se carga en producción para no contaminar las métricas con visitas de desarrollo.
// Pon aquí el ID de la propiedad de Italy Pizza (G-XXXXXXXXXX). Vacío = sin analítica.
const GA_ID = '';
---

{
  import.meta.env.PROD && GA_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', GA_ID);
      </script>
    </>
  )
}
