---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

const CHECKOUT_URL = 'https://pay.hotmart.com/M103554863Y?checkoutMode=10&bid=1790506317999';

// Botón "Pincha aquí" del banner: abre WhatsApp con un mensaje ya escrito.
// Número en formato internacional, sin "+" ni espacios. Vacío = el botón no se muestra.
const WHATSAPP_NUMBER = '34602309088'; // +34 602 30 90 88
const WHATSAPP_MESSAGE = 'Hola, acabo de pedir la masa universal gratis y tengo una consulta.';
const CONTACT_URL = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}` : '';

// Banner superior que invita a la comunidad de WhatsApp. Vacío = el banner no se muestra.
// Mientras no exista la comunidad, abre un chat con el número y un mensaje ya escrito.
// Cuando la crees, pon aquí el enlace de invitación (https://chat.whatsapp.com/...).
const COMMUNITY_MESSAGE = 'Hola, quiero unirme a la comunidad de Italy Pizza.';
const COMMUNITY_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(COMMUNITY_MESSAGE)}`;

// Precio en €. Sin precio ancla: solo se muestra el precio real de Hotmart.
const fmt = (n: number) => n.toFixed(2).replace('.', ',');
const PRICE_N = 7.28;
const PRICE = fmt(PRICE_N);

// SEO: keyword principal "pizzas caseras fáciles" (+ "masa universal para pizza").
const title = 'Pizzas Caseras Fáciles: Masa Universal + 15 Recetas | Italy Pizza';
const description =
  'Ebook con una masa universal paso a paso, 15 recetas de pizzas caseras fáciles y 2 focaccias sorpresa. Sin experiencia previa y con garantía de 7 días.';
const PAGE_PATH = '/pizzas-caseras-faciles';
const site = Astro.site;
const canonical = site ? new URL(PAGE_PATH, site).href : undefined;
const abs = (path: string) => (site ? new URL(path, site).href : path);
const ogImage = abs('/ventas/og-pizzas-caseras-faciles.jpg');

const icons = {
  gift: 'M3 8h18v4H3V8Zm2 4h14v9H5v-9Zm7-4v13M12 8c-2 0-4-1-4-3s3-2 4 3Zm0 0c2 0 4-1 4-3s-3-2-4 3Z',
  shield: 'M12 3 4 6v6c0 4.5 3.2 8 8 9 4.8-1 8-4.5 8-9V6l-8-3Zm-3 9 2 2 4-4',
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7l1-8Z',
  lock: 'M6 11h12v9H6v-9Zm2 0V8a4 4 0 0 1 8 0v3',
  check: 'm5 12 5 5 9-10',
  question: 'M9 9a3 3 0 1 1 4.2 2.7c-.8.4-1.2 1-1.2 1.8M12 17.5v.5',
  repeat: 'M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3',
  flame: 'M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5Z',
  pizza: 'M15 11h.01M11 15h.01M16 16h.01M2 16l20 6-6-20A20 20 0 0 0 2 16ZM5.71 17.11a17.04 17.04 0 0 1 11.4-11.4',
  sparkle: 'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Zm7 12 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z',
  list: 'M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01',
};

const problems = [
  {
    icon: 'question',
    title: '¿Por dónde empiezo?',
    text: 'No necesitas experiencia previa: aprendes a hacer pizzas desde cero, sin complicarte.',
  },
  {
    icon: 'flame',
    title: 'La masa nunca sale igual',
    text: 'Una sola masa universal, explicada paso a paso, ideal para cualquier tipo de pizza.',
  },
  {
    icon: 'repeat',
    title: 'Siempre la misma pizza',
    text: '15 combinaciones sencillas pero llenas de sabor para cocinar en casa para tu familia o amigos.',
  },
];

const categories = [
  { icon: 'flame', name: 'Masa universal' },
  { icon: 'pizza', name: '15 pizzas' },
  { icon: 'sparkle', name: '2 focaccias' },
  { icon: 'list', name: 'Paso a paso' },
];

const focaccias = [1, 2];

const steps = [
  { title: 'Pulsa el botón', text: 'Te llevamos al checkout seguro de Hotmart.' },
  { title: 'Completa tu pago', text: 'Pago único con los métodos disponibles en Hotmart.' },
  { title: 'Recibe el acceso', text: 'Te llega por email. Ábrelo o descárgalo en móvil, tablet u ordenador.' },
];

const included = [
  'Receta de masa universal paso a paso',
  '15 recetas de pizzas caseras',
  '2 recetas sorpresa de focaccias',
];

const faqs = [
  {
    q: '¿Para quién es este producto?',
    a: 'Para cualquier persona que quiera preparar pizzas caseras de forma fácil y sin complicaciones: quienes cocinan en casa para su familia o amigos, principiantes que quieren aprender desde cero o personas interesadas en emprender y vender pizzas desde casa.',
  },
  {
    q: '¿Necesito experiencia previa?',
    a: 'No. La masa universal viene explicada paso a paso para que te salga bien y obtengas buenos resultados desde la primera vez.',
  },
  {
    q: '¿Qué incluye exactamente?',
    a: 'Una receta de masa universal ideal para cualquier tipo de pizza, 15 recetas de pizzas con combinaciones sencillas pero llenas de sabor y 2 recetas sorpresa de focaccias.',
  },
  {
    q: '¿Es un producto físico?',
    a: 'No. Es un ebook 100% digital: lo abres o lo descargas en el móvil, la tablet o el ordenador.',
  },
  {
    q: '¿Cómo accedo al producto?',
    a: 'Recibes el acceso por email. También lo encuentras en Hotmart: inicia sesión, ve a "Mi cuenta" y después a "Mis compras".',
  },
  {
    q: '¿Cómo funciona la garantía?',
    a: 'Tienes 7 días desde la compra para pedir el reembolso integral si el producto no te resulta satisfactorio. Se solicita desde la propia plataforma de Hotmart.',
  },
  {
    q: '¿Quién procesa el pago?',
    a: 'Hotmart, una plataforma de pagos segura. La compra y la entrega del acceso se gestionan ahí.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Pizzas Caseras Fáciles: Masa Universal + 15 Recetas y 2 Focaccias Sorpresa',
    description,
    image: ogImage,
    brand: { '@type': 'Brand', name: 'Italy Pizza' },
    category: 'Ebook de recetas',
    ...(canonical && { url: canonical }),
    offers: {
      '@type': 'Offer',
      price: PRICE_N.toFixed(2),
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url: CHECKOUT_URL,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#2b1a13" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Italy Pizza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Ebook Pizzas Caseras Fáciles: masa universal, 15 recetas y 2 focaccias sorpresa" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="overflow-x-hidden pb-20 md:pb-0" data-price={PRICE_N}>
    <!-- BANNER DE CONFIRMACIÓN: solo aparece al llegar desde el formulario (?enviado=1) -->
    <div id="lead-banner" hidden>
      <div role="status" aria-live="polite" class="lead-banner relative overflow-hidden border-b-[3px] border-pizza-amber bg-linear-to-r from-pizza-deep via-pizza-brown to-pizza-deep text-white shadow-[0_10px_30px_rgba(43,26,19,.35)]">
        <div class="pointer-events-none absolute -top-16 -left-10 size-48 rounded-full bg-pizza-success/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-10 -bottom-16 size-48 rounded-full bg-pizza-red/25 blur-3xl"></div>

        <div class="relative mx-auto flex max-w-[1180px] flex-col items-center gap-4 px-5 py-5 pr-14 text-center sm:px-6 sm:pr-16 md:flex-row md:gap-6 md:py-4 md:text-left">
          <div class="relative flex size-14 shrink-0 items-center justify-center">
            <span class="lead-check-ring absolute inset-0 rounded-full bg-pizza-success" aria-hidden="true"></span>
            <svg viewBox="0 0 52 52" class="relative size-14 drop-shadow-[0_6px_14px_rgba(62,207,142,.45)]" fill="none" aria-hidden="true">
              <circle class="lead-check-circle" cx="26" cy="26" r="25" fill="#3ecf8e" />
              <path class="lead-check-mark" d="M15 27.5l8 8L38 19" pathLength="1" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <div class="md:flex-1">
            <p class="m-0 font-display text-lg leading-snug font-extrabold sm:text-xl">
              ¡Tu masa universal fue enviada a tu correo!
            </p>
            <p class="m-0 mt-1 text-sm leading-[1.55] text-white/80 sm:text-[15px]">
              Revisa tu bandeja de entrada (y la carpeta de spam, por si acaso).
            </p>
          </div>

          {
            CONTACT_URL && (
              <a
                href={CONTACT_URL}
                target="_blank"
                rel="noopener"
                class="group inline-flex min-h-[46px] shrink-0 items-center justify-center rounded-full bg-white px-6 text-sm font-extrabold text-pizza-deep shadow-[0_8px_20px_rgba(0,0,0,.25)] transition hover:-translate-y-0.5 hover:bg-pizza-amber-light focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-pizza-amber"
              >
                Pincha aquí <span class="ml-2 transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
              </a>
            )
          }
        </div>

        <button
          type="button"
          id="lead-banner-close"
          aria-label="Cerrar aviso"
          class="absolute top-2.5 right-3 flex size-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-pizza-amber sm:right-4"
        >
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
    </div>

    <!-- COMUNIDAD DE WHATSAPP -->
    {
      COMMUNITY_URL && (
        <div id="community-banner" role="region" aria-label="Comunidad de WhatsApp" class="lead-banner relative overflow-hidden border-b-[3px] border-[#25d366] bg-linear-to-r from-pizza-deep via-pizza-brown to-pizza-deep text-white shadow-[0_10px_30px_rgba(43,26,19,.35)]">
          <div class="pointer-events-none absolute -top-16 -left-10 size-48 rounded-full bg-[#25d366]/25 blur-3xl" />
          <div class="pointer-events-none absolute -right-10 -bottom-16 size-48 rounded-full bg-pizza-amber/20 blur-3xl" />

          <div class="relative mx-auto flex max-w-[1180px] flex-col items-center gap-4 px-5 py-5 pr-14 text-center sm:px-6 sm:pr-16 md:flex-row md:gap-6 md:py-4 md:text-left">
            <div class="relative flex size-14 shrink-0 items-center justify-center">
              <span class="lead-check-ring absolute inset-0 rounded-full bg-[#25d366]" aria-hidden="true" />
              <span class="lead-check-circle relative flex size-14 items-center justify-center rounded-full bg-[#25d366] shadow-[0_6px_14px_rgba(37,211,102,.45)]">
                <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /><path d="M8 12h.01M12 12h.01M16 12h.01" stroke-width="2.6" /></svg>
              </span>
            </div>

            <div class="md:flex-1">
              <p class="m-0 font-display text-lg leading-snug font-extrabold sm:text-xl">
                ¿Te apasiona la pizza casera? Únete a nuestra comunidad
              </p>
              <p class="m-0 mt-1 text-sm leading-[1.55] text-white/80 sm:text-[15px]">
                Escríbenos por WhatsApp y te sumamos gratis a la comunidad de Italy Pizza.
              </p>
            </div>

            <a
              href={COMMUNITY_URL}
              target="_blank"
              rel="noopener"
              class="group inline-flex min-h-[46px] shrink-0 items-center justify-center rounded-full bg-[#25d366] px-6 text-sm font-extrabold text-white shadow-[0_8px_20px_rgba(0,0,0,.25)] transition hover:-translate-y-0.5 hover:bg-[#1ebe5a] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-pizza-amber"
            >
              Unirme gratis <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </div>

          <button
            type="button"
            id="community-banner-close"
            aria-label="Cerrar aviso de la comunidad"
            class="absolute top-2.5 right-3 flex size-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-pizza-amber sm:right-4"
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
      )
    }

    <!-- ANNOUNCEMENT -->
    <div class="bg-pizza-deep px-4 py-2.5 text-center text-xs font-semibold tracking-wide text-white sm:text-[13px]">
      <span class="text-pizza-amber">SORPRESA:</span> 2 recetas de focaccia incluidas · Garantía de 7 días
    </div>

    <!-- HERO -->
    <header class="relative overflow-hidden bg-pizza-cream">
      <div class="pointer-events-none absolute -top-32 -right-24 size-[420px] rounded-full bg-pizza-red/12 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-24 size-[420px] rounded-full bg-pizza-amber/20 blur-3xl"></div>

      <div class="relative mx-auto max-w-[1180px] px-5 pt-6 pb-16 sm:px-6 lg:pt-8 lg:pb-24">
        <img src="/assets/logo-italypizza.png" alt="Italy Pizza" width="2064" height="549" class="mx-auto mb-8 w-[150px] lg:mx-0 lg:w-[180px]" />

        <div class="grid items-center gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:gap-14">
          <div class="text-center lg:text-left">
            <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-pizza-brown/10 bg-white px-4 py-2 text-[11px] font-bold tracking-[0.8px] text-pizza-brown shadow-sm">
              <span class="size-2 animate-pulse rounded-full bg-pizza-red"></span>
              EBOOK · MASA UNIVERSAL + 15 RECETAS + 2 FOCACCIAS
            </div>

            <h1 class="mb-5 font-display text-[38px] leading-[1.04] font-extrabold tracking-[-1.6px] text-pizza-text sm:text-5xl lg:text-[clamp(44px,4.8vw,64px)] lg:tracking-[-2.6px]">
              <span class="text-pizza-red">Pizzas caseras fáciles</span> con una sola <span class="text-pizza-brown">masa universal</span>
            </h1>

            <p class="mx-auto mb-7 max-w-[560px] text-base leading-[1.65] text-pizza-muted sm:text-lg lg:mx-0">
              Descubre cómo hacer pizzas caseras con combinaciones sencillas pero llenas de sabor. Empieza a cocinar en casa para tu familia o amigos, y aprende a hacer pizzas <strong class="text-pizza-text">desde cero sin complicarte</strong>.
            </p>

            <ul class="mx-auto mb-8 grid max-w-[480px] gap-3 text-left lg:mx-0">
              {
                ['Masa universal explicada paso a paso', '15 recetas de pizzas + 2 focaccias sorpresa', 'Acceso inmediato desde cualquier dispositivo'].map((t) => (
                  <li class="flex items-center gap-3 text-[15px] font-semibold">
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-pizza-basil text-white">
                      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.check} /></svg>
                    </span>
                    {t}
                  </li>
                ))
              }
            </ul>

            <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
              <a href={CHECKOUT_URL} target="_blank" rel="nofollow noopener" class="cta group relative isolate inline-flex min-h-[62px] w-full items-center justify-center overflow-hidden rounded-2xl bg-linear-to-br from-[#d23a3d] to-[#b3242a] px-8 text-base font-extrabold text-white shadow-[0_14px_32px_rgba(190,40,43,.4)] transition hover:-translate-y-0.5 sm:w-auto sm:text-[17px]">
                <span class="pointer-events-none absolute inset-y-0 -left-1/3 -z-10 w-1/4 animate-shine bg-white/30"></span>
                Quiero hacer mis pizzas
                <span class="ml-2.5 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>

            <p class="mt-4 flex items-center justify-center gap-1.5 text-[12px] text-pizza-muted lg:justify-start">
              <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.lock} /></svg>
              Pago seguro procesado por Hotmart
            </p>
          </div>

          <div class="relative mx-auto w-full max-w-[560px]">
            <div class="absolute inset-[6%] rounded-full bg-linear-to-br from-[#fbe3c8] to-white"></div>
            <div class="relative rotate-[1.5deg] rounded-[28px] bg-white p-3 shadow-[0_40px_80px_rgba(91,48,28,.22)] sm:p-4">
              <img src="/ventas/producto.webp" alt="Ebook 15 pizzas caseras fáciles: masa base, 15 recetas y 2 recetas sorpresa, por Ernesto Daniel Longone" width="600" height="600" fetchpriority="high" class="block h-auto w-full rounded-[20px]" />
            </div>
            <span class="absolute -top-3 -right-1 rotate-6 animate-float rounded-xl bg-pizza-red px-4 py-2.5 text-[11px] font-extrabold tracking-wider text-white shadow-[0_12px_24px_rgba(190,40,43,.35)] sm:right-2 sm:text-xs" style="--tw-float-rot:6deg">+2 FOCACCIAS SORPRESA</span>
            <span class="absolute -bottom-4 left-0 flex -rotate-3 items-center gap-2 rounded-xl bg-pizza-deep px-4 py-2.5 text-[11px] font-bold text-white shadow-xl sm:left-4 sm:text-xs">
              <svg viewBox="0 0 24 24" class="size-4 text-pizza-amber" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.shield} /></svg>
              Garantía de 7 días
            </span>
          </div>
        </div>
      </div>
    </header>

    <main>
      <!-- STRIP -->
      <section class="bg-pizza-deep text-white">
        <div class="mx-auto grid max-w-[1180px] grid-cols-2 gap-y-6 px-5 py-8 sm:px-6 lg:grid-cols-4">
          {
            [
              ['1', 'masa universal'],
              ['15', 'recetas de pizzas'],
              ['2', 'focaccias sorpresa'],
              ['7 días', 'de garantía'],
            ].map(([n, l]) => (
              <div class="text-center">
                <p class="m-0 font-display text-3xl font-extrabold text-pizza-amber sm:text-4xl">{n}</p>
                <p class="m-0 mt-1 text-xs text-white/70 sm:text-sm">{l}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- PROBLEM -->
      <section class="bg-white py-20 sm:py-24">
        <div class="mx-auto max-w-[1080px] px-5 sm:px-6">
          <div class="mx-auto max-w-[720px] text-center">
            <p class="mb-3 text-[11px] font-extrabold tracking-[1.3px] text-pizza-red">MÁS SABOR, MENOS COMPLICACIONES</p>
            <h2 class="mb-4 font-display text-[30px] leading-[1.12] font-extrabold tracking-[-1.2px] sm:text-[44px] sm:tracking-[-1.8px]">¿Quieres hacer pizza en casa y no sabes por dónde empezar?</h2>
            <p class="m-0 text-base leading-[1.7] text-pizza-muted sm:text-[17px]">Con una buena masa y recetas claras, hacer pizza casera es mucho más fácil de lo que parece.</p>
          </div>

          <div class="mt-12 grid gap-5 md:grid-cols-3">
            {
              problems.map((p) => (
                <article class="rounded-3xl border border-pizza-brown/10 bg-pizza-cream p-7 transition hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(91,48,28,.1)]">
                  <div class="mb-5 flex size-13 items-center justify-center rounded-2xl bg-pizza-red/12 text-pizza-red">
                    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[p.icon as keyof typeof icons]} /></svg>
                  </div>
                  <h3 class="mb-2 font-display text-lg font-extrabold">{p.title}</h3>
                  <p class="m-0 text-sm leading-[1.65] text-pizza-muted">{p.text}</p>
                </article>
              ))
            }
          </div>
